#include <winver.h>

// The version comes from project() in CMakeLists.txt (MDVIEW_VER_*, MDVIEW_VERSION).

// Common Controls 6 for the settings dialog (ISOLATIONAWARE_NOSTATICIMPORT_MANIFEST_RESOURCE_ID).
3 24 "mdview.manifest"

// Flag emoji (Twemoji, CC-BY 4.0), see scripts/gen_flags.py.
FLAGS RCDATA "twemoji-flags.bin"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MDVIEW_VER_MAJOR,MDVIEW_VER_MINOR,MDVIEW_VER_PATCH,0
 PRODUCTVERSION MDVIEW_VER_MAJOR,MDVIEW_VER_MINOR,MDVIEW_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "BlitzMD - fast Markdown viewer (Lister plugin) for Total Commander"
            VALUE "FileVersion", MDVIEW_VERSION
            VALUE "InternalName", "blitzmd"
            VALUE "LegalCopyright", "MIT License"
            VALUE "ProductName", "BlitzMD"
            VALUE "ProductVersion", MDVIEW_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
